{
  "name": "study-pilot",
  "private": true,
  "description": "学习平台辅助工具（中国大学 MOOC / 智慧树）：整理课程待办与截止时间，可辅助完成客观题测验",
  "author": "Ryan Liu",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm --filter @study-pilot/extension build",
    "dev": "pnpm --filter @study-pilot/extension dev",
    "probe": "node scripts/probe/probe.mjs",
    "lint": "oxlint --deny-warnings packages apps scripts",
    "changeset": "changeset",
    "e2e": "node scripts/e2e-smoke.mjs"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RyanRuiLiu/study-pilot.git"
  },
  "homepage": "https://github.com/RyanRuiLiu/study-pilot#readme",
  "bugs": {
    "url": "https://github.com/RyanRuiLiu/study-pilot/issues"
  },
  "keywords": [
    "browser-extension",
    "icourse163",
    "zhihuishu",
    "education",
    "wxt"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "js-beautify": "^2.0.3",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1"
  }
}
