{
  "$schema": "../../node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/probe/checks/*.mjs",
        "scripts/probe/inspect/*.mjs",
        "scripts/probe/maintain/*.mjs",
        "scripts/probe/run/*.mjs",
        "scripts/verify/*.mjs",
        /*
         * 仓库根的 vitest 配置。各包自己装了 vitest，knip 的 vitest 插件认得出
         * 它们的 vitest.config.ts；根目录没有 vitest 依赖，插件不生效，于是这份
         * 配置会被报成「未使用文件」。它是给 vitest 读的入口，登记成 entry。
         */
        "vitest.config.ts"
      ]
    }
  },
  "ignoreDependencies": [
    "syncpack",
    "remark-cli",
    "remark-validate-links"
  ],
  /*
   * JSDoc 类型不足以让 TypeScript 直接读 .mjs，所以 Node 侧的实现配一份同名的
   * .d.mts 声明（chrome-path.mjs / chrome-path.d.mts）。knip 的依赖图里
   * 「.mjs 的兄弟 .d.mts」这条边不成立，于是把声明文件报成未使用；
   * 实际引用它的是 wxt.config.ts 的类型检查。这是 knip 的已知盲区，
   * 用官方给出的 ignoreFiles 精确登记这一类文件，不放宽其它判断。
   */
  "ignoreFiles": ["**/scripts/probe/lib/*.d.mts"]
}
