{
  "$schema": "../../node_modules/knip/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "scripts/probe/checks/*.mjs",
        "scripts/probe/inspect/*.mjs",
        "scripts/probe/maintain/*.mjs",
        "scripts/probe/run/*.mjs",
        "scripts/verify/*.mjs"
      ]
    }
  },
  "ignoreDependencies": [
    "syncpack",
    "remark-cli",
    "remark-validate-links"
  ]
}
