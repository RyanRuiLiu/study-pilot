{
  "name": "@study-pilot/cli",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "study-pilot": "./.output/main.mjs"
  },
  "scripts": {
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --banner:js=\"#!/usr/bin/env node\" --outfile=.output/main.mjs",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@study-pilot/application": "workspace:*",
    "@study-pilot/platform-mooc": "workspace:*",
    "@study-pilot/platform-zhs": "workspace:*",
    "@study-pilot/adapters-node": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "0.28.2",
    "vitest": "^5.0.5",
    "typescript": "^7.0.2"
  }
}
